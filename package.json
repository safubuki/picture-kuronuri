{
  "name": "picture-kuronuri",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:rules": "node tests/rules-regression.cjs",
    "test:ocr": "node tests/ocr-regression.cjs",
    "test:faces": "node tests/face-avatar-regression.cjs",
    "test:redaction": "node tests/redaction-regression.cjs",
    "test:llm": "node tests/local-llm-regression.cjs && node tests/model-cache-regression.cjs",
    "test:manual": "node tests/manual-stroke-regression.cjs",
